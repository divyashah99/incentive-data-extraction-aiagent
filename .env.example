# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — this file (.env.example) is safe to commit.
# NEVER put real API keys in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM to use for parsing. Options: groq (default) | gemini
LLM_PROVIDER=groq

# ── Groq (default — free tier, very fast) ────────────────────────────────────
# Get your free API key at: https://console.groq.com
# Free tier: 14,400 requests/day, 500K tokens/day
GROQ_API_KEY=your-groq-api-key-here
# Model options: llama-3.3-70b-versatile (default, best quality)
#                llama3-8b-8192 (faster, lighter)
#                mixtral-8x7b-32768 (good for long content)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (fallback — free tier) ─────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/apikey
# Free tier: 15 requests/min, 1.5M tokens/day
GOOGLE_API_KEY=your-google-api-key-here
# Model options: gemini-1.5-flash (default, fast + free)
#                gemini-2.0-flash (newer, also free)
GEMINI_MODEL=gemini-1.5-flash

# ── LangSmith Monitoring (free — highly recommended) ─────────────────────────
# Sign up free at: https://smith.langchain.com
# Traces every LLM call automatically — inputs, outputs, latency, tokens.
# Just set these 3 vars; no code changes needed.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=dreamline-incentive-extraction

# ── Scraping settings ─────────────────────────────────────────────────────────
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Playwright: 1=headless (default), 0=show browser window (useful for debugging)
PLAYWRIGHT_HEADLESS=1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
